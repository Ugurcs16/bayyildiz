# Canlı site ve SEO (tam URL, sonda / olmadan)
NEXT_PUBLIC_SITE_URL=https://bayyildiz.com

# Tervona public Storefront API (server-only — asla NEXT_PUBLIC yapmayın)
# Production: https://tervona.vercel.app
# Local customer-auth: http://127.0.0.1:3000 (Tervona migration 0007 must be applied locally)
TERVONA_STOREFRONT_API_URL=https://tervona.vercel.app

# Shared BFF secret with Tervona. Server-only. Never prefix with NEXT_PUBLIC_.
# Browser must never see this value. Leave empty in git; set a long random string locally.
TERVONA_STOREFRONT_BFF_KEY=
# Same key also signs the HttpOnly guest checkout-access cookie.
# No extra Vercel env is required for Phase 4 checkout lookup.

# WooCommerce (eski; isteğe bağlı)
# NEXT_PUBLIC_WOOCOMMERCE_URL=
# WOOCOMMERCE_URL=
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=

# İsteğe bağlı: özel kahraman videosu (MP4, HTTPS)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://...
